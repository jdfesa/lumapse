<TR><TD ALIGN="LEFT" PORT="id" WIDTH="95">id</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="id_r" WIDTH="48">PK</TD></TR>

<TR><TD ALIGN="LEFT" PORT="title" WIDTH="95">title</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="title_r" WIDTH="48">—</TD></TR>

<TR><TD ALIGN="LEFT" PORT="content" WIDTH="95">content</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="content_r" WIDTH="48">—</TD></TR>

<TR><TD ALIGN="LEFT" PORT="pinned" WIDTH="95">pinned</TD><TD ALIGN="LEFT" WIDTH="56">INTEGER</TD><TD ALIGN="LEFT" PORT="pinned_r" WIDTH="48">D=0</TD></TR>

<TR><TD ALIGN="LEFT" PORT="archived" WIDTH="95">archived</TD><TD ALIGN="LEFT" WIDTH="56">INTEGER</TD><TD ALIGN="LEFT" PORT="archived_r" WIDTH="48">D=0</TD></TR>

<TR><TD ALIGN="LEFT" PORT="subjectId" WIDTH="95">subjectId</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="subjectId_r" WIDTH="48">FK</TD></TR>

<TR><TD ALIGN="LEFT" PORT="createdAt" WIDTH="95">createdAt</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="createdAt_r" WIDTH="48">NN</TD></TR>

<TR><TD ALIGN="LEFT" PORT="updatedAt" WIDTH="95">updatedAt</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="updatedAt_r" WIDTH="48">NN</TD></TR>

<TR><TD ALIGN="LEFT" PORT="statusEmoji" WIDTH="95">statusEmoji</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="statusEmoji_r" WIDTH="48">—</TD></TR>

<TR><TD ALIGN="LEFT" PORT="deletedAt" WIDTH="95">deletedAt</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="deletedAt_r" WIDTH="48">—</TD></TR></TABLE>>];
 academic_events [pos="455,445", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">

<TR><TD COLSPAN="3" BGCOLOR="#e8e8e8"><B>academic_events</B></TD></TR>


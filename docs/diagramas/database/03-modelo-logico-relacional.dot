<TR><TD ALIGN="LEFT" PORT="title" WIDTH="100">title</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="title_r" WIDTH="43">—</TD></TR>

<TR><TD ALIGN="LEFT" PORT="date" WIDTH="100">date</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="date_r" WIDTH="43">NN</TD></TR>

<TR><TD ALIGN="LEFT" PORT="subjectId" WIDTH="100">subjectId</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="subjectId_r" WIDTH="43">FK</TD></TR>

<TR><TD ALIGN="LEFT" PORT="createdAt" WIDTH="100">createdAt</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="createdAt_r" WIDTH="43">NN</TD></TR>

<TR><TD ALIGN="LEFT" PORT="updatedAt" WIDTH="100">updatedAt</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="updatedAt_r" WIDTH="43">NN</TD></TR></TABLE>>];
 metadata [pos="175,445", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">

<TR><TD COLSPAN="3" BGCOLOR="#e8e8e8"><B>metadata</B></TD></TR>

<TR><TD ALIGN="LEFT" WIDTH="110"><B>Columna</B></TD><TD WIDTH="56"><B>Tipo</B></TD><TD WIDTH="38"><B>SQL</B></TD></TR>

<TR><TD ALIGN="LEFT" PORT="key" WIDTH="110">key</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="key_r" WIDTH="38">PK</TD></TR>

<TR><TD ALIGN="LEFT" PORT="value" WIDTH="110">value</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="value_r" WIDTH="38">—</TD></TR></TABLE>>];
 constraints [pos="300,185", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="1">

<TR><TD ALIGN="LEFT"><B>REFERENCIAS Y CARDINALIDADES · FK → PK</B></TD></TR>

<TR><TD ALIGN="LEFT">subjects.parentSubjectId → subjects.id · ON DELETE CASCADE¹</TD></TR>


<TR><TD ALIGN="LEFT">notes.subjectId → subjects.id · ON DELETE SET NULL</TD></TR>


<TR><TD ALIGN="LEFT">academic_events.subjectId → subjects.id · ON DELETE SET NULL</TD></TR>


<TR><TD ALIGN="LEFT">Las tres FK admiten NULL. ON UPDATE no declarado: NO ACTION.</TD></TR>

<TR><TD ALIGN="LEFT"><B>RESTRICCIONES E ÍNDICES FÍSICOS</B></TD></TR>

<TR><TD ALIGN="LEFT">academic_events.type: CHECK (type IN ('parcial', 'final', 'tp', 'exposicion'))</TD></TR>

<TR><TD ALIGN="LEFT">Índices explícitos no únicos en academic_events:</TD></TR>

<TR><TD ALIGN="LEFT">idx_academic_events_date (date) · idx_academic_events_subject (subjectId)</TD></TR>

<TR><TD ALIGN="LEFT"><B>LECTURA Y LÍMITES</B></TD></TR>

<TR><TD ALIGN="LEFT">Pata de gallo: círculo + barra = 0..1; círculo + tres ramas = 0..N.</TD></TR>
<TR><TD ALIGN="LEFT">El símbolo junto a una tabla cuenta sus filas por cada fila del otro extremo.</TD></TR>
<TR><TD ALIGN="LEFT">«Por A: (mín,máx) B»: cantidad de B vinculados a cada A; N = muchos.</TD></TR>

<TR><TD ALIGN="LEFT">PK: PRIMARY KEY · FK: FOREIGN KEY · NN: NOT NULL explícito · D=0: DEFAULT 0.</TD></TR>

<TR><TD ALIGN="LEFT">Sin NN se admite NULL, incluso en estas PK; sin DEFAULT, la omisión es NULL.</TD></TR>

<TR><TD ALIGN="LEFT">¹ Por sección: (1,1) materia padre; por materia: (0,N) secciones [dominio].</TD></TR>

<TR><TD ALIGN="LEFT">Raíz: parentSubjectId=NULL. Dos niveles y nombres por nivel: servicio.</TD></TR>

<TR><TD ALIGN="LEFT">La FK no impone roles ni profundidad, y no evita ciclos.</TD></TR>

<TR><TD ALIGN="LEFT">Sin CHECK de UUID, formato de fecha o indicadores 0/1. metadata: sin FK.</TD></TR>

<TR><TD ALIGN="LEFT">ON DELETE corresponde al borrado físico, no a deletedAt (papelera).</TD></TR></TABLE>>];
 header [pos="300,785", label=<<TABLE BORDER="0" CELLBORDER="0" CELLPADDING="0">
<TR><TD ALIGN="LEFT"><FONT POINT-SIZE="15"><B>MODELO LÓGICO RELACIONAL · RC1</B></FONT></TD></TR>
<TR><TD ALIGN="LEFT">4 tablas · 26 columnas · Pata de gallo · Esquema SQLite</TD></TR></TABLE>>];
 // Puertos de fila y recorridos ortogonales explícitos; no alterar sin verificar su geometría.
 // Los dos accesos a id terminan en esquinas distintas para no superponer símbolos.

<TR><TD ALIGN="LEFT" PORT="id" WIDTH="100">id</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="id_r" WIDTH="43">PK</TD></TR>


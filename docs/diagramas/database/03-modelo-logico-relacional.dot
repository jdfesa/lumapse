// Figura documental contrastada con connection.js RC1 (bcefe6a).
// Regeneración: dot -Kneato -n2 -Tsvg <este archivo> -o 03-modelo-logico-relacional.svg
// Posiciones en puntos. Los extremos representan cardinalidades SQL, no reglas por rol.
// FK -> PK: crowodot en la FK (0..N), teeodot en la PK (0..1).
// pos conserva los puntos de conexión de los puertos; -n2 mantiene nodos y recorridos.
// NN reproduce NOT NULL explícito; PK no lo implica en estas tablas SQLite.
digraph Logical {
 graph [bgcolor="white", margin=0, pad=0.08, splines=polyline, outputorder=edgesfirst, notranslate=true];
 node [shape=plain, fontname="DejaVu Sans", fontsize=12];
 edge [dir=both, arrowtail=crowodot, arrowhead=teeodot, arrowsize=0.8,
       color="#222222", penwidth=1.1, fontname="DejaVu Sans", fontsize=12];
 subjects [pos="175,650", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">

<TR><TD COLSPAN="3" BGCOLOR="#e8e8e8"><B>subjects</B></TD></TR>

<TR><TD ALIGN="LEFT" WIDTH="110"><B>Columna</B></TD><TD WIDTH="56"><B>Tipo</B></TD><TD WIDTH="38"><B>SQL</B></TD></TR>

<TR><TD ALIGN="LEFT" PORT="id" WIDTH="110">id</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="id_r" WIDTH="38">PK</TD></TR>

<TR><TD ALIGN="LEFT" PORT="name" WIDTH="110">name</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="name_r" WIDTH="38">NN</TD></TR>

<TR><TD ALIGN="LEFT" PORT="parentSubjectId" WIDTH="110">parentSubjectId</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="parentSubjectId_r" WIDTH="38">FK</TD></TR>

<TR><TD ALIGN="LEFT" PORT="archived" WIDTH="110">archived</TD><TD ALIGN="LEFT" WIDTH="56">INTEGER</TD><TD ALIGN="LEFT" PORT="archived_r" WIDTH="38">D=0</TD></TR>

<TR><TD ALIGN="LEFT" PORT="color" WIDTH="110">color</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="color_r" WIDTH="38">—</TD></TR>

<TR><TD ALIGN="LEFT" PORT="createdAt" WIDTH="110">createdAt</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="createdAt_r" WIDTH="38">NN</TD></TR>

<TR><TD ALIGN="LEFT" PORT="deletedAt" WIDTH="110">deletedAt</TD><TD ALIGN="LEFT" WIDTH="56">TEXT</TD><TD ALIGN="LEFT" PORT="deletedAt_r" WIDTH="38">—</TD></TR></TABLE>>];
 notes [pos="455,650", label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="2">

<TR><TD COLSPAN="3" BGCOLOR="#e8e8e8"><B>notes</B></TD></TR>


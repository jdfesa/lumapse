---
config:
  deterministicIds: true
  deterministicIDSeed: lumapse-conceptual
  htmlLabels: false
  theme: base
  look: classic
  layout: dagre
  fontFamily: Arial, sans-serif
  themeCSS: 'text { font-family: Arial, sans-serif; } .edgeLabel .label { font-size: 18px; }'
  themeVariables:
    fontFamily: Arial, sans-serif
    fontSize: 18px
    primaryColor: '#ffffff'
    primaryTextColor: '#111111'
    primaryBorderColor: '#111111'
    lineColor: '#111111'
    secondaryColor: '#ffffff'
    tertiaryColor: '#ffffff'
  er:
    useMaxWidth: false
    nodeSpacing: 35
    rankSpacing: 100
    entityPadding: 12
    minEntityWidth: 100
    minEntityHeight: 35
---
%% Lumapse 0.6.0/600 — RC1. Modelo conceptual, no esquema de tablas.
%% Los tipos expresan conceptos del dominio, no tipos de almacenamiento SQL.
%% Las asociaciones reemplazan las columnas de referencia del nivel lógico.
erDiagram
    direction TB

    SUBJECT["MATERIA / SECCIÓN"] {
        UUID identificador
        Texto nombre
        Indicador archivada
        Texto color "opcional"
        FechaHora creación
        FechaHora eliminación "opcional"
    }

    NOTE["NOTA"] {
        UUID identificador
        Texto título
        Markdown contenido
        Indicador fijada
        Indicador archivada
        Texto estado "opcional"
        FechaHora creación
        FechaHora actualización
        FechaHora eliminación "opcional"
    }

    EVENT["FECHA ACADÉMICA"] {
        UUID identificador
        Tipo tipo
        Texto título "opcional"
        Fecha fecha
        FechaHora creación
        FechaHora actualización
    }

    SUBJECT |o..o{ NOTE : "agrupa"
    SUBJECT |o..o{ EVENT : "asocia"
    SUBJECT |o..o{ SUBJECT : "contiene"
